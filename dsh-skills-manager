#!/usr/bin/env python3
"""One-click installer for the DSH Skills Manage plugin.

Commands:
  install          build and install the plugin into web + headless profiles
  uninstall        remove the plugin rows and profile dependencies
  rebuild-modes    rebuild modes/{main,plugin,all} symlink farms from source
  status           show installation state
"""
import json
import os
import shutil
import subprocess
import sys
from pathlib import Path

PROJECT = Path(__file__).resolve().parent
HARNESS = Path(os.environ.get('DSH_SKILLS_HARNESS') or Path.home() / 'AI_Coding' / 'deepseek-harness').expanduser().resolve()
HOST_SRC = PROJECT / 'packages' / 'dsh-skills-manager'
CLIENT_SRC = PROJECT / 'packages' / 'dsh-client-ui-skills-manager'
HARNESS_HOST_DIR = HARNESS / 'packages' / 'skill' / 'skills-manage'
HARNESS_CLIENT_DIR = HARNESS / 'packages' / 'client' / 'ui-skills-manage'
# Profiles link the built harness packages (workspace deps resolve there).
HOST_PKG = HARNESS_HOST_DIR
CLIENT_PKG = HARNESS_CLIENT_DIR
MODES_ROOT = PROJECT / 'modes'
SOURCE = Path(os.environ.get('DSH_SKILLS_SOURCE') or Path.home() / 'Coding_Setting').expanduser().resolve()
DSH_HOME = Path(os.environ.get('DSH_HOME') or Path.home() / '.dsh').expanduser().resolve()
LIBRARY_DIR = MODES_ROOT / 'all'
MANAGED_LIBRARY = DSH_HOME / 'skills-manage' / 'library'
HOST_NAME = '@deepseek-ai/dsh-skills-manage'
CLIENT_NAME = '@deepseek-ai/dsh-client-ui-skills-manage'


def sh(cmd, cwd=None):
    print('+', ' '.join(str(c) for c in cmd))
    return subprocess.run([str(c) for c in cmd], cwd=cwd, check=False)


def discover(source: Path):
    items = []
    roots = [
        ('main', source / 'skills'),
        ('plugin', source / 'plugins' / 'cache' / 'claude-plugins-official' / 'mattpocock-skills' / '1.2.3' / 'skills'),
    ]
    for group, root in roots:
        if not root.is_dir():
            continue
        for dirpath, _dirs, files in os.walk(root):
            if Path(dirpath) == root:
                continue
            if 'SKILL.md' in files:
                items.append((group, Path(dirpath).name, dirpath))
    return sorted(items)


def rebuild_modes():
    items = discover(SOURCE)
    if not SOURCE.exists():
        print(f'提示: 未找到 Skill 源 {SOURCE}，将创建空 modes；安装后可在 Web UI 中导入 Skill。')
    elif not items:
        print(f'提示: {SOURCE} 下没有发现 Skill，将创建空 modes；安装后可在 Web UI 中导入 Skill。')
    groups = {
        'main': [it for it in items if it[0] == 'main'],
        'plugin': [it for it in items if it[0] == 'plugin'],
        'all': items,
    }
    MODES_ROOT.mkdir(parents=True, exist_ok=True)
    for mode, mode_items in groups.items():
        mode_dir = MODES_ROOT / mode
        mode_dir.mkdir(parents=True, exist_ok=True)
        for entry in mode_dir.iterdir():
            if entry.is_symlink():
                entry.unlink()
        for _group, name, target in mode_items:
            link = mode_dir / name
            if link.exists() or link.is_symlink():
                link.unlink()
            link.symlink_to(target)
        print(f'[{mode}] {len(mode_items)} links')
    return 0


def ensure_harness_refs():
    '''Ensure the standalone packages are referenced by the harness aggregate tsconfigs.'''
    host_ref = '{ "path": "./packages/skill/skills-manage" },'
    client_ref = '{ "path": "./packages/client/ui-skills-manage" },'
    host_file = HARNESS / 'tsconfig.host.json'
    client_file = HARNESS / 'tsconfig.client.json'
    for file, ref in ((host_file, host_ref), (client_file, client_ref)):
        text = file.read_text()
        if ref in text:
            continue
        marker = '    { "path": "./packages/skill/tool-skill" },\n' if file == host_file else '    { "path": "./packages/client/ui-settings-plugin-inventory" },\n'
        if marker not in text:
            print(f'warning: cannot patch {file} automatically; 请确认 harness 已包含 skills-manager 包引用')
            continue
        text = text.replace(marker, marker + ref + '\n', 1)
        file.write_text(text)
        print(f'patched {file}')

def sync_source_to_harness():
    '''Copy the canonical package sources from this repo into the harness workspace.'''
    for source, target in ((HOST_SRC, HARNESS_HOST_DIR), (CLIENT_SRC, HARNESS_CLIENT_DIR)):
        target.parent.mkdir(parents=True, exist_ok=True)
        shutil.copytree(source, target, dirs_exist_ok=True, ignore=shutil.ignore_patterns('node_modules', 'lib', '*.tsbuildinfo'))
        print(f'synced {source} -> {target}')

def copy_build_back():
    '''Copy built lib artifacts back into the standalone packages.'''
    for source, target in ((HARNESS_HOST_DIR, HOST_SRC), (HARNESS_CLIENT_DIR, CLIENT_SRC)):
        for part in ('lib',):
            src = source / part
            dst = target / part
            if src.exists():
                shutil.copytree(src, dst, dirs_exist_ok=True)
                print(f'copied build {src} -> {dst}')

def build_plugin():
    if not HARNESS.exists():
        print(f'error: harness repo 不存在: {HARNESS}')
        print('请先 clone: git clone https://github.com/deepseek-ai/deepseek-harness ~/AI_Coding/deepseek-harness')
        return 1
    ensure_harness_refs()
    sync_source_to_harness()
    rc = sh(['corepack', 'pnpm', 'install'], cwd=HARNESS)
    if rc.returncode:
        return rc.returncode
    rc = sh(['corepack', 'pnpm', 'run', 'build:lib:host'], cwd=HARNESS)
    if rc.returncode:
        return rc.returncode
    rc = sh(['corepack', 'pnpm', 'exec', 'tsc', '-b', 'packages/client/ui-skills-manage'], cwd=HARNESS)
    if rc.returncode:
        return rc.returncode
    rc = sh(['corepack', 'pnpm', '--filter', CLIENT_NAME, 'run', 'bundle'], cwd=HARNESS)
    return rc.returncode


PATCH_BEGIN = '# >>> dsh-skills-manager >>>'
PATCH_END = '# <<< dsh-skills-manager <<<'


def managed_patch_text(include_client: bool) -> str:
    rows = ['- insert:',
            '    - id: skills-manage',
            f'      name: \'{HOST_NAME}\'',
            '      config:',
            '        libraryDirs:',
            f'          - {LIBRARY_DIR}',
            f'        managedLibraryDir: {MANAGED_LIBRARY}',
            '        rank: 250']
    if include_client:
        rows.append('    - id: ui-skills-manage')
        rows.append(f'      name: \'{CLIENT_NAME}\'')
    return PATCH_BEGIN + '\n' + '\n'.join(rows) + '\n' + PATCH_END + '\n'


def write_profile_patch(profile: Path, include_client: bool):
    patch_file = profile / 'cordis.patch.yml'
    lines = patch_file.read_text().splitlines(keepends=True) if patch_file.exists() else []

    # Remove an existing managed block.
    start = end = None
    for index, line in enumerate(lines):
        if line.strip() == PATCH_BEGIN:
            start = index
        elif line.strip() == PATCH_END and start is not None:
            end = index
            break
    if start is not None and end is not None:
        del lines[start:end + 1]

    # Remove legacy unmarked insert blocks owned by older installers.
    kept = []
    index = 0
    while index < len(lines):
        line = lines[index]
        if not line.startswith('- insert:'):
            kept.append(line)
            index += 1
            continue
        block = [line]
        cursor = index + 1
        owns_skills = False
        while cursor < len(lines):
            candidate = lines[cursor]
            if candidate.startswith('- ') and not candidate.startswith('- id:'):
                break
            if 'id: skills-manage' in candidate or 'id: ui-skills-manage' in candidate:
                owns_skills = True
            block.append(candidate)
            cursor += 1
        if owns_skills:
            index = cursor
            continue
        kept.extend(block)
        index = cursor
    lines = kept

    # Remove trailing empty lines before appending our block.
    while lines and lines[-1].strip() == '':
        lines.pop()
    if lines and not lines[-1].endswith('\n'):
        lines.append('\n')
    lines.append('\n' + managed_patch_text(include_client))
    patch_file.write_text(''.join(lines))
    print(f'合并写入 {patch_file}')


def profile_deps(profile: Path):
    pkg = profile / 'package.json'
    if not pkg.exists():
        return {}
    try:
        data = json.loads(pkg.read_text())
    except Exception:
        return {}
    return data.get('dependencies', {})


def ensure_profile(profile_name):
    profile = DSH_HOME / 'profiles' / profile_name
    if profile.exists():
        return profile
    dsh = shutil.which('dsh')
    if dsh is None:
        print(f'warning: 未找到 dsh 命令，无法初始化 profile {profile_name}')
        print('请先运行一次: dsh --profile ' + profile_name + ' --help')
        return profile
    sh(['dsh', '--profile', profile_name, '--help'])
    return profile


def install():
    rc = rebuild_modes()
    if rc:
        return rc
    rc = build_plugin()
    if rc:
        return rc
    copy_build_back()
    for profile_name, include_client in (('web', True), ('headless', False)):
        profile = ensure_profile(profile_name)
        if not profile.exists():
            print(f'跳过不存在的 profile: {profile}')
            continue
        packages = [str(HOST_PKG)] + ([str(CLIENT_PKG)] if include_client else [])
        sh(['corepack', 'pnpm', 'add', *packages], cwd=profile)
        write_profile_patch(profile, include_client)
    print('安装完成。启动: dsh web')
    return 0


def uninstall():
    for profile_name, include_client in (('web', True), ('headless', False)):
        profile = DSH_HOME / 'profiles' / profile_name
        if not profile.exists():
            continue
        names = [HOST_NAME] + ([CLIENT_NAME] if include_client else [])
        sh(['corepack', 'pnpm', 'remove', *names], cwd=profile)
        patch = profile / 'cordis.patch.yml'
        if patch.exists():
            lines = patch.read_text().splitlines(keepends=True)
            start = end = None
            for index, line in enumerate(lines):
                if line.strip() == PATCH_BEGIN:
                    start = index
                elif line.strip() == PATCH_END and start is not None:
                    end = index
                    break
            if start is not None and end is not None:
                del lines[start:end + 1]
                while lines and lines[-1].strip() == '':
                    lines.pop()
                if not lines:
                    lines = ['[]\n']
                patch.write_text(''.join(lines))
                print(f'从 {patch} 移除托管块')
    print('卸载完成')
    return 0


def status():
    print(f'项目: {PROJECT}')
    print(f'harness: {HARNESS} 存在={HARNESS.exists()}')
    print(f'source: {SOURCE} 存在={SOURCE.exists()}')
    print(f'library root: {LIBRARY_DIR}')
    print(f'managed library: {MANAGED_LIBRARY} 存在={MANAGED_LIBRARY.exists()}')
    for mode in ('main', 'plugin', 'all'):
        mode_dir = MODES_ROOT / mode
        n = len([p for p in mode_dir.iterdir() if p.is_symlink()]) if mode_dir.exists() else 0
        print(f'  [{mode}] {n} links')
    for profile_name in ('web', 'headless'):
        profile = DSH_HOME / 'profiles' / profile_name
        deps = profile_deps(profile)
        print(f'profile {profile_name}: host={HOST_NAME in deps} client={CLIENT_NAME in deps}')
    return 0


def usage():
    print(__doc__)
    return 0


def main():
    args = sys.argv[1:]
    if not args or args[0] in ('-h', '--help', 'help'):
        return usage()
    cmd = args[0]
    if cmd == 'install':
        return install()
    if cmd == 'uninstall':
        return uninstall()
    if cmd == 'rebuild-modes':
        return rebuild_modes()
    if cmd == 'status':
        return status()
    return usage()


if __name__ == '__main__':
    sys.exit(main())
